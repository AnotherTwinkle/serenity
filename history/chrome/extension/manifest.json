{
  "manifest_version": 3,
  "name": "Serenity",
  "version": "1.0",
  "host_permissions": ["<all_urls>"],
  "permissions": ["activeTab", "nativeMessaging", "scripting", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "run-script": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Serenity browser extension"
    }
  }
}
